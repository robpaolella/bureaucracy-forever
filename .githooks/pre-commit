#!/usr/bin/env bash
# Enforced by git itself, so it applies no matter how git was invoked —
# a shell, an agent, an IDE, bash -c, xargs. Bypassable only with
# --no-verify, which the Claude Code PreToolUse hook denies separately.
set -uo pipefail

BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
if [ "$BRANCH" = "HEAD" ] && ! git rev-parse HEAD >/dev/null 2>&1; then
  BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
fi

case "$BRANCH" in
  main|master)
    cat >&2 <<MSG

  Commit refused: '$BRANCH' is a protected branch.

  Move the work to a feature branch:

      git switch -c <type>/<short-description>

  See /git/maestro/docs/git-workflow.md.

MSG
    exit 1
    ;;
  staging)
    # Staging moves only by merging a feature branch or main into it. A merge
    # commit is allowed (git runs pre-merge-commit, not this hook, for a clean
    # merge; MERGE_HEAD marks a conflicted one being concluded).
    if [ -z "$(git rev-parse -q --verify MERGE_HEAD 2>/dev/null)" ]; then
      cat >&2 <<MSG

  Commit refused: 'staging' is a deploy target, never committed to directly.

  Commit on a feature branch, then merge it in:

      git switch staging && git merge --no-ff <branch> && git push

  See /git/maestro/docs/git-workflow.md.

MSG
      exit 1
    fi
    ;;
esac
exit 0
