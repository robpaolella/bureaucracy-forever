      "css": ".ds-field-label {display:block;margin-bottom:8px;font-family:var(--font-ui,Archivo,system-ui,sans-serif);font-size:12px;line-height:16px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--fg-2,#A3AFC2)} .ds-input {box-sizing:border-box;width:100%;height:46px;padding:0 14px;border:1px solid var(--line-strong,#323C4C);border-radius:var(--r-control,4px);background:var(--ink-700,#1B222E);color:var(--fg,#E8EDF7);font-family:var(--font-ui,Archivo,system-ui,sans-serif);font-size:15px;line-height:22.5px} .ds-input::placeholder {color:var(--fg-3,#6F7C90)} .ds-input:focus-visible { outline: 2px solid var(--teal, #6FC8DC); outline-offset: 2px; } .ds-input[aria-invalid=\"true\"] {border-color:var(--stop,#E08A8A);background:var(--stop-wash,#241416)} .ds-input:read-only {border-color:var(--line,#232B38);background:var(--ink-800,#141922);color:var(--fg-3,#6F7C90)}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Card.tsx medium padding, resting surface. This non-interactive preview intentionally has no hover or focus state.",
      "html": "<div class=\"ds-card\">Guild information</div>",
      "css": ".ds-card {padding:24px;border:1px solid var(--line,#232B38);border-radius:var(--r-card,8px);background:var(--ink-850,#0E1219);color:var(--fg,#E8EDF7);font-family:var(--font-ui,Archivo,system-ui,sans-serif);font-size:16px;line-height:24px}"
    },
    {
      "name": "Neutral Tag",
      "kind": "chip",
      "refersTo": "tag",
      "description": "Badges.tsx: plain fact, not an interactive filter.",
      "html": "<span class=\"ds-tag\">Melee DPS</span>",
      "css": ".ds-tag {display:inline-flex;align-items:center;padding:5px 10px;border:1px solid var(--line-strong,#323C4C);border-radius:var(--r-tag,2px);background:var(--ink-700,#1B222E);color:var(--fg-2,#A3AFC2);font-family:var(--font-ui,Archivo,system-ui,sans-serif);font-size:12px;line-height:16px;font-weight:600}"
    },
    {
      "name": "Labelled Status",
      "kind": "chip",
      "refersTo": "status-ok",
      "description": "Badges.tsx: non-interactive status, dot plus a word.",
      "html": "<span class=\"ds-status\"><span class=\"ds-status-dot\" aria-hidden=\"true\"></span>High need</span>",
      "css": ".ds-status {display:inline-flex;align-items:center;gap:7px;padding:5px 11px;border:1px solid var(--ok-line,#2E5C44);border-radius:9999px;background:var(--ok-wash,#12251C);color:var(--ok,#79D0A0);font-family:var(--font-ui,Archivo,system-ui,sans-serif);font-size:12px;line-height:16px;font-weight:600} .ds-status-dot {height:6px;width:6px;border-radius:9999px;background:var(--ok,#79D0A0)}"
    },
    {
      "name": "Header Navigation",
      "kind": "nav",
      "refersTo": "nav-active",
      "description": "NavLink.tsx desktop active and inactive states. Preview links target only the snippet.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Example navigation\"><a href=\"#ds-nav-about\" id=\"ds-nav-about\" aria-current=\"page\">About</a><a href=\"#ds-nav-raiding\" id=\"ds-nav-raiding\">Raiding</a></nav>",
      "css": ".ds-nav {display:flex;gap:26px;background:var(--ink-950,#06080B)} .ds-nav a {display:flex;align-items:center;box-sizing:border-box;height:72px;border-bottom:2px solid transparent;color:var(--fg-2,#A3AFC2);font-family:var(--font-ui,Archivo,system-ui,sans-serif);font-size:14px;line-height:20px;font-weight:500;text-decoration:none;transition:color 120ms cubic-bezier(0.4,0,0.2,1)} .ds-nav a:hover {color:var(--fg,#E8EDF7)} .ds-nav a[aria-current=\"page\"] {border-bottom-color:var(--sand,#E4C08A);color:var(--fg,#E8EDF7)} .ds-nav a:focus-visible { outline: 2px solid var(--teal, #6FC8DC); outline-offset: 2px; }"
    },
    {
      "name": "Section Heading",
      "kind": "custom",
      "description": "SectionHead.tsx medium: mobile 30px, desktop 38px; example text makes no achievement claim.",
      "html": "<div class=\"ds-section\"><span class=\"ds-eyebrow\">Recruitment</span><h2 class=\"ds-heading\">Current recruitment needs</h2></div>",
      "css": ".ds-section {display:flex;flex-direction:column;gap:10px} .ds-eyebrow {font-family:var(--font-eyebrow,Cinzel,Georgia,serif);font-size:11px;line-height:1.2;font-weight:600;letter-spacing:.28em;text-transform:uppercase;color:var(--sand,#E4C08A)} .ds-heading {margin:0;font-family:var(--font-display,Newsreader,Georgia,serif);font-size:30px;line-height:1.1;font-weight:500;color:var(--fg,#E8EDF7)} @media(min-width:768px) {.ds-heading {font-size:38px}}"
    }
  ],
  "narrative": {
    "northStar": "The Guild Standard",
    "overview": "Dark, restrained and editorial: serif headlines over compact, bordered tools; sand for emphasis, teal for interaction. The Guild Standard names both a guild banner and the standards the guild holds. It describes the existing world, not a redesign or a new theme.\n\nPublic pages give headlines and guild identity room; operational areas use denser tables, labelled states and direct controls. Preserve the distinction rather than applying marketing-page density to a roster or turning every public section into a dashboard.",
    "keyCharacteristics": [
      "Ink grounds and Ice text, with Sand and Teal in distinct roles.",
      "Newsreader headlines, Cinzel eyebrows, Archivo controls and prose.",
      "Thin borders and tonal surfaces; tight corners on tools.",
      "Restrained state changes, explicit labels, and guild identity assets."
    ],
    "rules": [
      {
        "name": "The Labelled State Rule",
        "body": "Status color accompanies a word; it never replaces one. These recorded colors do not establish contrast compliance on every possible surface—test the actual pairing against PRODUCT.md's requirements.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** use implemented tokens and component variants; compare affected surfaces at 1440 and 390 widths.",
      "**Do** preserve Sand emphasis, Teal interaction and visible keyboard focus.",
      "**Do** label states and both guild and viewer-local times; follow PRODUCT.md's confirmed accessibility requirements.",
      "**Do** distinguish approved product claims from live copy awaiting correction."
    ],
    "donts": [
      "**Don't** restore handover layouts, sample schedules or placeholder policy merely because an artboard shows them.",
      "**Don't** add resting-card shadows, a light theme, or new asset conventions when documenting this existing system.",
      "**Don't** use class or item-quality colors as brand fills; retain the narrow domain exceptions in PRODUCT.md.",
      "**Don't** treat recorded token values as proof of accessibility compliance or code-only observations as authenticated live verification."
    ]
  }
}
