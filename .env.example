# Copy to .env.local and fill in. Never commit .env.local.

# Auth.js. Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Discord application, from https://discord.com/developers/applications
# (Auth.js reads these names for the Discord provider automatically.)
# Register this redirect URI on the application, one per environment:
#   <AUTH_URL>/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Bot token, used server-side to read a member's guild roles at sign-in.
DISCORD_BOT_TOKEN=

# The guild whose roles decide access.
DISCORD_GUILD_ID=

# Role → access mapping. See lib/auth/roles.ts. Two ids, nothing else:
#   officer <- DISCORD_ROLE_OFFICER only
#   member  <- DISCORD_ROLE_MEMBER
#   social  <- everyone else
# There is deliberately no DISCORD_ROLE_ADMIN. Discord Administrator grants nothing here.
DISCORD_ROLE_OFFICER=
DISCORD_ROLE_MEMBER=

# Public invite shown on "Join Discord" buttons.
NEXT_PUBLIC_DISCORD_INVITE_URL=
