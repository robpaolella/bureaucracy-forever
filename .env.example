# Copy to .env.local and fill in. Never commit .env.local.

# Auth.js. Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
# Required in production (the host is not trusted from headers there). Optional in dev.
AUTH_URL=http://localhost:3000

# Discord application, from https://discord.com/developers/applications
# (Auth.js reads these names for the Discord provider automatically.)
# Register this redirect URI on the application, one per environment:
#   <AUTH_URL>/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Bot token, used server-side to read a member's guild roles at sign-in.
DISCORD_BOT_TOKEN=

# The guild whose roles decide access.
DISCORD_GUILD_ID=

# Role → access mapping. See lib/auth/roles.ts. Two ids, nothing else:
#   officer <- DISCORD_ROLE_OFFICER only
#   member  <- DISCORD_ROLE_MEMBER
#   social  <- everyone else
# Discord Administrator grants no access level here (there is no DISCORD_ROLE_ADMIN).
DISCORD_ROLE_OFFICER=
DISCORD_ROLE_MEMBER=
# Guild Master and Administrator role ids. They only unlock deleting raid templates; they do
# not make anyone an officer. Optional: with neither set, nobody can delete templates.
DISCORD_ROLE_GUILD_MASTER=
DISCORD_ROLE_ADMINISTRATOR=
# The Raider role the bot keeps in step with the web roster rank (SYNC-SPEC §9.6). Optional: unset means no role sync jobs.
DISCORD_ROLE_RAIDER=

# Public invite shown on "Join Discord" buttons.
NEXT_PUBLIC_DISCORD_INVITE_URL=

# Postgres (Neon). DATABASE_URL is the pooled string from the Neon dashboard; the app uses
# it through the pg driver adapter. DIRECT_URL is the same string with "-pooler" removed
# from the host; Prisma migrations use it.
DATABASE_URL=
DIRECT_URL=

# Shared with the Discord bot (its env file carries the same value). The bot sends it as
# `Authorization: Bearer …` on every /api/bot/* request (SYNC-SPEC §2). Generate with:
# openssl rand -base64 33. Leave unset to disable /api/bot/* (they answer 503).
BOT_SHARED_SECRET=
DISCORD_ROLE_TRIAL=
DISCORD_ROLE_SOCIAL=
DISCORD_ROLE_GUEST=
