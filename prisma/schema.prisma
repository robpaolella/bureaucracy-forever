// Bureaucracy data model. Follows design-handover/docs/06-data-model.md, which is a
// proposal with two things to preserve: availability stored in the member's LOCAL time
// with the zone they painted in, and sign-ups carrying a `source` for the Discord sync.
//
// The database URL lives in prisma.config.ts (migrations use DIRECT_URL) and lib/db.ts
// (the app uses the pooled DATABASE_URL through the pg driver adapter).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Access level, derived from Discord guild roles at sign-in and cached on the session.
/// The mapping is lib/auth/roles.ts and nothing else grants OFFICER.
enum Role {
  SOCIAL
  MEMBER
  OFFICER
}

enum WowClass {
  WARRIOR
  PALADIN
  HUNTER
  ROGUE
  PRIEST
  SHAMAN
  MAGE
  WARLOCK
  DRUID
}

enum RaidRole {
  TANK
  HEALER
  MELEE
  RANGED
}

/// Display rank on the roster. Distinct from User.role: an officer is always rank
/// OFFICER, but a TRIAL is role MEMBER.
enum Rank {
  OFFICER
  RAIDER
  TRIAL
  SOCIAL
}

enum Response {
  ACCEPT
  TENTATIVE
  ABSENT
}

/// Where a sign-up came from. Shown on every sign-up row; never inferred or hidden.
enum Source {
  WEB
  DISCORD
}

enum AppPath {
  RAIDER
  SOCIAL
}

enum AppStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NeedStatus {
  HIGH
  MEDIUM
  CLOSED
}

/// Sign-up rules, SYNC-SPEC §7: the roster is derived from rank; anyone else who answers is on the bench.
enum Standing {
  ROSTER
  BENCH
}

/// SYNC-SPEC §3/§6: SCHEDULED until locksAt, LOCKED until an hour after the night, then DONE.
enum RaidStatus {
  SCHEDULED
  LOCKED
  DONE
  CANCELLED
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/// Hard reserve: the holder rolls before anyone else. Soft reserve: rolls when nobody hard-reserved.
enum ReserveKind {
  HR
  SR
}

/// How a drop was handed out. DISENCHANT_BANK has no character.
enum LootMethod {
  HR
  SR
  MAIN_SPEC
  OFF_SPEC
  OPEN_ROLL
  DISENCHANT_BANK
}

/// Which Wowhead database an item's details come from.
enum ItemSource {
  CLASSIC
  FOREVER
}

model User {
  id              String        @id @default(cuid())
  discordId       String        @unique
  discordName     String
  avatarUrl       String?
  role            Role          @default(SOCIAL)
  /// Roster rank. Follows the Discord Raider / Trial / Officer roles and the web roster editor,
  /// whichever wrote last; the main character's rank mirrors it (docs/04 § Roster).
  rank            Rank          @default(SOCIAL)
  /// Holds Guild Member or Officer in Discord. Only these appear on the roster.
  inGuild         Boolean       @default(false)
  /// When the trial began: a raider application accepted, or the Trial role or rank set.
  /// Tick posts the trial check-in to #officers (Promote / Extend) from it (SYNC-SPEC §3).
  trialStartedAt  DateTime?
  /// When the trial check-in was posted; cleared by an extension so it comes back.
  trialNudgedAt   DateTime?
  /// When the next trial check-in is due; null means trialStartedAt + TRIAL_DAYS.
  trialCheckInAt  DateTime?
  /// Last time the bot's member snapshot touched this row.
  discordSyncedAt DateTime?
  /// IANA zone the member chose; overrides browser detection (docs/01 § Time).
  timezone        String?
  characters      Character[]
  availability    Availability?
  signups         Signup[]
  notes           OfficerNote[] @relation("noteAuthor")
  /// Sign-ups this officer answered on someone's behalf.
  signupsSet      Signup[]      @relation("signupSetBy")
  /// Applications this officer accepted or declined.
  decisions       Application[] @relation("applicationDecidedBy")
  reserves        Reserve[]
  lootAwards      LootAward[]
  createdAt       DateTime      @default(now())
}

model Character {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String      @unique
  class      WowClass
  spec       String
  raidRole   RaidRole
  rank       Rank        @default(TRIAL)
  isMain     Boolean     @default(true)
  /// 0–1, computed from Signup history.
  attendance Float?
  joinedAt   DateTime    @default(now())
  reserves   Reserve[]
  lootAwards LootAward[]
  signups    Signup[]

  @@index([userId])
}

/// One row per member. `slots` is the painted week, keys "day:slot", day 0 = Monday,
/// slot 0 = 00:00, slot 47 = 23:30, in `timezone`, NOT guild time (docs/05 § Shared model).
model Availability {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timezone  String
  /// Record<`${0..6}:${0..47}`, "available" | "if-needed">
  slots     Json
  updatedAt DateTime @updatedAt
}

/// One raid tier, SYNC-SPEC §3. Seeded with the production raid templates; officers edit on /officers/raids.
model RaidTemplate {
  id           String       @id @default(cuid())
  name         String       @unique
  /// "MC": calendar chips and Discord post titles.
  short        String
  size         Int
  durationMin  Int          @default(180)
  /// { tank, healer, melee, ranged } — sums to size.
  requirements Json
  active       Boolean      @default(true)
  series       RaidSeries[]
  raids        Raid[]
  lootBosses   LootBoss[]
  reserveSettings LootReserveSetting[]
}

/// A weekly slot in guild time. tick (SYNC-SPEC §6) turns it into Raid rows horizonWeeks ahead.
model RaidSeries {
  id                String       @id @default(cuid())
  templateId        String
  template          RaidTemplate @relation(fields: [templateId], references: [id])
  /// 0 = Sunday … 6 = Saturday, in GUILD_TZ.
  weekday           Int
  /// "20:00", wall clock in GUILD_TZ. Not UTC: this is what keeps 8 PM at 8 PM across DST.
  startTime         String
  durationMin       Int
  notes             String?
  postAheadDays     Int          @default(14)
  lockMinutesBefore Int          @default(120)
  horizonWeeks      Int          @default(4)
  active            Boolean      @default(true)
  /// Guild dates ("2026-11-19") whose instance an officer deleted; tick never regenerates them.
  skippedDates      String[]     @default([])
  /// The officer who made it; a plain id, not a relation, so the series outlives the account.
  createdById       String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  raids             Raid[]
}

model Raid {
  id               String        @id @default(cuid())
  name             String
  /// Absolute instant; render twice per viewer (guild zone and theirs).
  startsAt         DateTime
  durationMin      Int           @default(180)
  notes            String?
  /// Legacy: a Discord scheduled event id. Nullable, unused; do not build on it (SYNC-SPEC §3).
  discordEventId   String?       @unique
  cancelledAt      DateTime?
  /// Why it was cancelled; the bot re-renders the compact line from this (SYNC-SPEC §8).
  cancelReason     String?
  /// { tank: 2, healer: 8, melee: 11, ranged: 14 }
  requirements     Json
  signups          Signup[]
  templateId       String?
  template         RaidTemplate? @relation(fields: [templateId], references: [id])
  seriesId         String?
  series           RaidSeries?   @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  /// Edited individually; series edits skip it.
  detached         Boolean       @default(false)
  status           RaidStatus    @default(SCHEDULED)
  /// startsAt − lockMinutesBefore. Members cannot answer after this (SYNC-SPEC §7).
  locksAt          DateTime
  lockedAt         DateTime?
  /// The #raid-signups forum post and its starter message.
  discordThreadId  String?       @unique
  discordMessageId String?
  postedAt         DateTime?
  /// Set when each reminder was enqueued.
  remind72At       DateTime?
  remind24At       DateTime?
  /// Set when reserve reminders were evaluated, including when nobody was owed one.
  remindReservesAt DateTime?
  /// Optimistic concurrency for officer edits.
  updatedAt        DateTime      @updatedAt
  reserves         Reserve[]
  lootAwards       LootAward[]

  /// One instance per series per instant: the officer's request and the bot's tick can both generate.
  @@unique([seriesId, startsAt])
  @@index([startsAt])
  @@index([status, locksAt])
}

model Signup {
  id          String    @id @default(cuid())
  raidId      String
  raid        Raid      @relation(fields: [raidId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId String?
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  /// Null while a roster member has not answered yet (SYNC-SPEC §3).
  response    Response?
  standing    Standing  @default(ROSTER)
  /// Set by officers after the raid.
  attended    Boolean?
  source      Source
  /// Optional, for ABSENT.
  reason      String?
  /// An officer answering on someone's behalf. Nulled if that account is removed.
  setByUserId String?
  setBy       User?     @relation("signupSetBy", fields: [setByUserId], references: [id], onDelete: SetNull)
  updatedAt   DateTime  @updatedAt

  @@unique([raidId, userId])
  @@index([characterId])
}

model Application {
  id               String        @id @default(cuid())
  path             AppPath
  status           AppStatus     @default(PENDING)
  discordId        String
  discordName      String
  character        String
  class            WowClass?
  spec             String?
  logsUrl          String?
  /// { questionKey: answer }
  answers          Json
  /// Drives the unread dot in the inbox.
  readAt           DateTime?
  decidedAt        DateTime?
  decidedByUserId  String?
  decidedBy        User?         @relation("applicationDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  notes            OfficerNote[]
  createdAt        DateTime      @default(now())
  /// Intake is web-only; kept for symmetry with Signup and OfficerNote.
  source           Source        @default(WEB)
  /// The #applications forum post and its starter message.
  discordThreadId  String?       @unique
  discordMessageId String?
  reopenedAt       DateTime?
  /// The 24 h pending nudge was sent.
  nudgedAt         DateTime?

  @@index([status, createdAt])
}

/// Private to officers. Never exposed on any applicant-facing surface.
model OfficerNote {
  id               String      @id @default(cuid())
  applicationId    String
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId         String
  author           User        @relation("noteAuthor", fields: [authorId], references: [id])
  body             String
  createdAt        DateTime    @default(now())
  source           Source      @default(WEB)
  /// Discord-origin: the thread message this note IS. Web-origin: the mirror the bot posted.
  discordMessageId String?     @unique
  editedAt         DateTime?
  /// Soft delete: hidden on the web, deleted in Discord.
  deletedAt        DateTime?

  @@index([applicationId])
}

/// One row per class+need spec. Drives the recruitment table, the home teaser and the bot's
/// /recruiting reply. All three read this; none duplicate it. A spec that fills two seats is
/// two need specs with their own status (`spec` 'Feral Tank' and 'Feral Melee DPS'); `roles`
/// holds the one role each recruits.
model ClassNeed {
  id        String     @id @default(cuid())
  class     WowClass
  spec      String
  roles     RaidRole[]
  status    NeedStatus @default(CLOSED)
  /// Shown first on the home page, starred. At most one row, and only while HIGH.
  featured  Boolean    @default(false)
  updatedAt DateTime   @updatedAt

  @@unique([class, spec])
}

/// Work for the bot (SYNC-SPEC §5). The site writes; the bot polls, runs, acks.
model OutboxJob {
  id        String    @id @default(cuid())
  type      String
  payload   Json
  status    JobStatus @default(PENDING)
  attempts  Int       @default(0)
  /// Backoff: PENDING jobs are handed out only once this has passed.
  runAfter  DateTime  @default(now())
  lockedAt  DateTime?
  lastError String?
  /// What the bot reported on ack.
  result    Json?
  createdAt DateTime  @default(now())

  @@index([status, runAfter])
}

/// Replay protection for bot writes: the Idempotency-Key and the response it first got.
model BotRequest {
  key        String   @id
  statusCode Int
  body       Json
  createdAt  DateTime @default(now())
}

/// Cached item details from Wowhead, keyed by the WoW item id. Filled only by the import
/// script and the officer refresh action, never on a page view (lib/loot-items.ts).
model LootItem {
  id          Int              @id
  name        String
  /// 0 poor … 5 legendary, as Wowhead reports it.
  quality     Int
  /// Icon file name, e.g. "inv_sword_12"; the image lives on wow.zamimg.com.
  icon        String
  /// Wowhead's tooltip HTML after the allowlist in lib/tooltip-sanitize.ts. Sanitized again on render.
  tooltipHtml String
  source      ItemSource
  fetchedAt   DateTime
  entries     LootTableEntry[]
  reserveSettings LootReserveSetting[]
  reserves    Reserve[]
  awards      LootAward[]
}

/// One boss (or the trash entry) in a raid tier's loot table, in kill order.
model LootBoss {
  id         String           @id @default(cuid())
  templateId String
  template   RaidTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  position   Int
  isTrash    Boolean          @default(false)
  entries    LootTableEntry[]
  awards     LootAward[]

  @@unique([templateId, name])
}

/// An item a boss can drop. The same item can sit on several bosses.
model LootTableEntry {
  bossId   String
  boss     LootBoss @relation(fields: [bossId], references: [id], onDelete: Cascade)
  itemId   Int
  item     LootItem @relation(fields: [itemId], references: [id])
  position Int

  @@id([bossId, itemId])
  @@index([itemId])
}

/// Per-item reserve policy shared by every boss and raid in a tier. Missing rows allow reserves,
/// with a win limit of 1.
model LootReserveSetting {
  templateId String
  template   RaidTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  itemId     Int
  item       LootItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  blocked    Boolean @default(false)
  /// HR/SR wins one character may have of this item before it can't reserve it again, 1 to 5
  /// (a CHECK constraint in the migration). A blocked item stays blocked whatever this is.
  winLimit   Int     @default(1)

  @@id([templateId, itemId])
  @@index([itemId])
}

/// A member's hard or soft reserve for one raid (lib/loot-rules.ts). One of each per member
/// per raid, never on the same item: both enforced here as well as in the rules.
model Reserve {
  id          String      @id @default(cuid())
  raidId      String
  raid        Raid        @relation(fields: [raidId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId String
  character   Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  itemId      Int
  item        LootItem    @relation(fields: [itemId], references: [id])
  kind        ReserveKind
  /// An officer who set it on the member's behalf; a plain id so it outlives the account.
  setById     String?
  updatedAt   DateTime    @updatedAt

  @@unique([raidId, userId, kind])
  @@unique([raidId, userId, itemId])
  @@index([raidId, itemId])
}

/// A drop handed out on a raid. Never deleted: a correction voids it. Character and boss
/// names are copied so the record survives roster and loot-table edits.
model LootAward {
  id            String     @id @default(cuid())
  /// Restrict: a raid with loot recorded cannot be deleted, only cancelled.
  raidId        String
  raid          Raid       @relation(fields: [raidId], references: [id], onDelete: Restrict)
  bossId        String?
  boss          LootBoss?  @relation(fields: [bossId], references: [id], onDelete: SetNull)
  bossName      String?
  itemId        Int
  item          LootItem   @relation(fields: [itemId], references: [id])
  /// Null only for DISENCHANT_BANK (a CHECK constraint in the migration).
  characterId   String?
  character     Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  characterName String?
  userId        String?
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  method        LootMethod
  roll          Int?
  note          String?
  /// Plain ids, not relations, so the record outlives the officer's account.
  recordedById  String
  createdAt     DateTime   @default(now())
  voidedAt      DateTime?
  voidedById    String?
  voidReason    String?

  @@index([raidId])
  @@index([characterId, itemId])
}
